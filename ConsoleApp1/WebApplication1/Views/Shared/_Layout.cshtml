<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Portfolio</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== Mobile top bar (visible below md breakpoint) ===== -->
	<nav class="navbar navbar-dark bg-dark d-md-none fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" href="#home">Roque, Kevin Clerck A.</a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas"
                    aria-controls="sidebarOffcanvas" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <!-- ===== Offcanvas sidebar (mobile) ===== -->
    <div class="offcanvas offcanvas-start bg-dark text-white d-md-none" tabindex="-1" id="sidebarOffcanvas">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav nav-pills flex-column mb-auto px-3">
                <li class="nav-item"><a href="#home" class="nav-link text-white sidebar-link"><i class="bi bi-house-door me-2"></i>Home</a></li>
                <li class="nav-item"><a href="#about" class="nav-link text-white sidebar-link"><i class="bi bi-person me-2"></i>About Me</a></li>
                <li class="nav-item"><a href="#skills" class="nav-link text-white sidebar-link"><i class="bi bi-code-slash me-2"></i>Skills</a></li>
                <li class="nav-item"><a href="#projects" class="nav-link text-white sidebar-link"><i class="bi bi-folder2-open me-2"></i>Projects</a></li>
                <li class="nav-item"><a href="#contact" class="nav-link text-white sidebar-link"><i class="bi bi-envelope me-2"></i>Contact</a></li>
            </ul>
        </div>
    </div>

    <div class="d-flex">

        <!-- ===== Fixed sidebar (desktop, md and up) — positioning handled in site.css ===== -->
        <nav class="sidebar d-none d-md-flex flex-column bg-dark text-white p-4">
            <a href="#home" class="d-flex align-items-center mb-4 text-white text-decoration-none">
                <i class="bi bi-terminal fs-3 me-2 flex-shrink-0"></i>
                <span class="sidebar-brand fw-semibold">Roque, Kevin Clerck A.</span>
            </a>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item"><a href="#home" class="nav-link text-white sidebar-link"><i class="bi bi-house-door me-2"></i>Home</a></li>
                <li class="nav-item"><a href="#about" class="nav-link text-white sidebar-link"><i class="bi bi-person me-2"></i>About Me</a></li>
                <li class="nav-item"><a href="#skills" class="nav-link text-white sidebar-link"><i class="bi bi-code-slash me-2"></i>Skills</a></li>
                <li class="nav-item"><a href="#projects" class="nav-link text-white sidebar-link"><i class="bi bi-folder2-open me-2"></i>Projects</a></li>
                <li class="nav-item"><a href="#contact" class="nav-link text-white sidebar-link"><i class="bi bi-envelope me-2"></i>Contact</a></li>
            </ul>
            <hr class="text-secondary" />
            <small class="text-secondary">&copy; @DateTime.Now.Year</small>
        </nav>

        <!-- ===== Main content ===== -->
        <main class="flex-grow-1 main-content">
            <div class="container-fluid py-4 px-3 px-md-5">
                @RenderBody()
            </div>

            <footer class="text-center py-3 border-top mt-4 text-muted">
                &copy; @DateTime.Now.Year - Roque, Kevin Clerck A. Built with ASP.NET Core MVC &amp; Bootstrap 5.
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Fix: on mobile, close the offcanvas menu first, THEN smooth-scroll
        // to the target section. Doing both at once caused the scroll to be
        // skipped or interrupted by the closing animation.
        document.querySelectorAll('#sidebarOffcanvas .sidebar-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var targetId = this.getAttribute('href');
                var offcanvasEl = document.getElementById('sidebarOffcanvas');
                var offcanvasInstance = bootstrap.Offcanvas.getInstance(offcanvasEl) || new bootstrap.Offcanvas(offcanvasEl);

                offcanvasEl.addEventListener('hidden.bs.offcanvas', function handler() {
                    var target = document.querySelector(targetId);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                    offcanvasEl.removeEventListener('hidden.bs.offcanvas', handler);
                });

                offcanvasInstance.hide();
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
