<!-- ============ HOME ============ -->
<section id="home" class="py-5">
    <div class="row align-items-center g-5">
        <div class="col-12 col-md-7">
            <p class="text-primary fw-semibold mb-1">Hello, I'm</p>
            <h1 class="display-5 fw-bold">Roque, Kevin Clerck A.</h1>
            <h4 class="text-muted mb-3">Aspiring Software Developer</h4>
            <p class="lead">
                I'm a 3rd-year Information Technology student who enjoys building clean,
                practical web applications. I like turning ideas into working software and
                I'm always looking for opportunities to learn new tools and frameworks.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a href="#projects" class="btn btn-primary btn-lg px-4">View Projects</a>
                <a href="#contact" class="btn btn-outline-secondary btn-lg px-4">Contact Me</a>
            </div>
        </div>
        <div class="col-12 col-md-5 text-center">
            <img src="~/images/pictureportfolio.png"
                 class="img-fluid rounded-circle shadow"
                 style="max-width: 250px;"
                 alt="Photo of Roque, Kevin Clerck A." />
        </div>
    </div>
</section>

<hr class="my-4" />

<!-- ============ ABOUT ME ============ -->
<section id="about" class="py-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-person-badge me-2"></i>About Me</h2>
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <p>
                I'm an Information Technology student from Lyceum of Alabang with a strong interest in web development and software engineering.
                Over the past two years, I've been studying front-end and back-end development, from building console programs to simple static
                sites using HTML, CSS and built-in programs in MS Access.
            </p>
            <p>
                I'm currently pursuing a Bachelor of Science in Information Technology,
                and my goal is to land an entry-level developer role where I can keep
                growing my skills, work alongside experienced engineers, and eventually
                specialize in full-stack development.
            </p>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title fw-semibold">Education</h6>
                    <p class="card-text mb-1">BS Information Technology</p>
                    <p class="card-text text-muted small mb-3">2023 - Present</p>
                    <h6 class="card-title fw-semibold">Career Goal</h6>
                    <p class="card-text mb-0">Land an entry-level developer role and grow into a full-stack engineer.</p>
                </div>
            </div>
        </div>
    </div>
</section>

