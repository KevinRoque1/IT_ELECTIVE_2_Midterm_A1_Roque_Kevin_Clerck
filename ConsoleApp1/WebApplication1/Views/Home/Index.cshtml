                <div class="modal-body">
                    <div id="simpleCalcCarousel" class="carousel slide">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/images/loan/1st.png" class="d-block w-100 rounded border" alt="Screenshot 1">
