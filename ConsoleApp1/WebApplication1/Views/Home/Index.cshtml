<section id="home" class="py-5">
    <div class="row align-items-center g-5">
        <div class="col-12 col-md-7">
            <p class="text-primary fw-semibold mb-1">@ViewData["Greeting"]</p>
            <h1 class="display-5 fw-bold">@ViewData["FullName"]</h1>
            <h4 class="text-muted mb-3">@ViewData["JobTitle"]</h4>
            <p class="lead">@ViewData["Intro"]</p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Home" asp-action="Projects" class="btn btn-primary btn-lg px-4">View Projects</a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-lg px-4">Contact Me</a>
            </div>
        </div>
        <div class="col-12 col-md-5 text-center">
            <img src="@Url.Content(ViewData["ProfileImage"] as string)"
                 class="img-fluid rounded-circle shadow"
                 style="max-width: 250px;"
                 alt="Photo of @ViewData["FullName"]" />
        </div>
    </div>
</section>