                        <span class="badge text-bg-light border me-1">Photoshop</span>
                        <span class="badge text-bg-light border me-1">HTML</span>
                        <span class="badge text-bg-light border">CSS</span>
                    </p>
                    <button type="button" class="btn btn-primary mt-auto" data-bs-toggle="modal" data-bs-target="#visualDesignModal">
                        View Details
                    </button>
                </div>
            </div>
        </div>

    </div>

 
    <div class="modal fade" id="visualDesignModal" tabindex="-1" aria-labelledby="visualDesignModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="visualDesignModalLabel">Visual Design Portfolio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="visualDesignCarousel" class="carousel slide">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/images/visualdesign/portfolio1.png" class="d-block w-100 rounded border" alt="About Me section">
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/visualdesign/portfolio2.png" class="d-block w-100 rounded border" alt="Gallery section">
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/visualdesign/portfolio3.png" class="d-block w-100 rounded border" alt="Activities section">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#visualDesignCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#visualDesignCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

   
    <div class="modal fade" id="simpleCalcModal" tabindex="-1" aria-labelledby="simpleCalcModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
