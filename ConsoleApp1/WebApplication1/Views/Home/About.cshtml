<section id="about" class="py-5">
    <h2 class="fw-bold mb-1"><i class="bi bi-person-badge me-2"></i>@ViewData["Title"]</h2>
    <p class="text-muted mb-4">@ViewData["Tagline"]</p>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <p>@ViewData["AboutParagraph1"]</p>
            <p>@ViewData["AboutParagraph2"]</p>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm about-card">
                <div class="card-body">
                    <h6 class="card-title fw-semibold">Education</h6>
                    <p class="card-text mb-1">@ViewData["EducationDegree"]</p>
                    <p class="card-text text-muted small mb-3">@ViewData["EducationYears"]</p>
                    <h6 class="card-title fw-semibold">Career Goal</h6>
                    <p class="card-text mb-0">@ViewData["CareerGoal"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}