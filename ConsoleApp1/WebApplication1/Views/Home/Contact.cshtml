<section id="contact" class="py-5">
    <h2 class="fw-bold mb-1"><i class="bi bi-envelope me-2"></i>@ViewData["Title"]</h2>
    <p class="text-muted mb-4">@ViewData["Tagline"]</p>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex align-items-center">
                    <i class="bi bi-envelope-fill text-primary me-3 fs-5"></i>
                    <a href="mailto:@ViewData["Email"]" class="text-decoration-none text-dark">@ViewData["Email"]</a>
                </li>
                <li class="list-group-item d-flex align-items-center">
                    <i class="bi bi-phone-fill text-primary me-3 fs-5"></i>
                    <a href="tel:@ViewData["Phone"]" class="text-decoration-none text-dark">@ViewData["PhoneDisplay"]</a>
                </li>
                <li class="list-group-item d-flex align-items-center">
                    <i class="bi bi-github text-primary me-3 fs-5"></i>
                    <a href="@ViewData["GitHubUrl"]" class="text-decoration-none text-dark" target="_blank" rel="noopener noreferrer">@ViewData["GitHubDisplay"]</a>
                </li>
                <li class="list-group-item d-flex align-items-center">
                    <i class="bi bi-linkedin text-primary me-3 fs-5"></i>
                    <a href="@ViewData["LinkedInUrl"]" class="text-decoration-none text-dark" target="_blank" rel="noopener noreferrer">@ViewData["LinkedInDisplay"]</a>
                </li>
                <li class="list-group-item d-flex align-items-center">
                    <i class="bi bi-facebook text-primary me-3 fs-5"></i>
                    <a href="@ViewData["FacebookUrl"]" class="text-decoration-none text-dark" target="_blank" rel="noopener noreferrer">@ViewData["FacebookDisplay"]</a>
                </li>
            </ul>
        </div>
        <div class="col-12 col-lg-6 d-flex align-items-center">
            <a href="@Url.Content(ViewData["ResumeFile"] as string)" class="btn btn-success btn-lg px-4" download="Roque_Kevin_Resume.pdf">
                <i class="bi bi-download me-2"></i>Download Resume
            </a>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}